# Copy to terraform.tfvars and fill in. Do NOT commit the real tfvars or state —
# origin_shared_secret lands in both. Use an encrypted remote backend.

service_name    = "ruyfo-planner"
domain_name     = "ruyfo.example.com"
backend_address = "origin.internal.example.com" # host running uvicorn, not publicly reachable
backend_port    = 8010
backend_use_ssl = false

# Origin lock-down (pick one or both — see variables.tf). Generate with:
#   openssl rand -hex 32
origin_shared_secret = ""

# Edge rate limiting
form_post_rate_limit = 30
form_post_penalty    = "10m"

# Next-Gen WAF / Bot Management (only if you enable ngwaf.tf)
ngwaf_corp            = ""
ngwaf_site_short_name = ""
